{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["node", "$app/types"],
		"paths": {
			"$lib": ["./src/lib/index.ts"],
			"$lib/*": ["./src/lib/*"],
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts"],
	"exclude": ["src/service-worker.ts", "src/service-worker.d.ts", "src/service-worker"]
}
